# ─────────────────────────────────────────────────────────────────────────────
# PlayPK environment template
# Copy into each app as needed — never commit real secrets.
#
#   cp .env.example apps/api/.env
#   cp .env.example apps/dashboard/.env.local   # then keep only NEXT_PUBLIC_* lines
#   cp apps/walkin/.env.example apps/walkin/.env.local
#   cp .env.example apps/mobile/.env            # then keep only EXPO_PUBLIC_* lines
# ─────────────────────────────────────────────────────────────────────────────

# ── API (apps/api/.env) ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# PostgreSQL (matches docker-compose.yml defaults — change password in production)
DATABASE_URL=postgresql://playpk:playpk@localhost:5432/playpk?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# JWT — replace with long random strings before any non-local use
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local file storage (S3-compatible interface; local disk in dev)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# Slot locking (Redis)
SLOT_LOCK_TTL_SECONDS=30

# AI / LLM (chatbot intent parsing — mock by default, no key required)
LLM_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Security — mock/free money paths (auto-false when NODE_ENV=production)
# ALLOW_MOCK_PAYMENTS=true
# CORS allowlist (comma-separated). Required in production for browser clients.
# CORS_ORIGINS=https://playpk.vercel.app,http://localhost:3000

# Dashboard — only set in non-prod or deliberate staging demos
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true

# Google Sign-In (optional). Same Web client ID on API + dashboard.
# Create at https://console.cloud.google.com/apis/credentials (OAuth 2.0 Web client).
# Authorized JavaScript origins: http://localhost:3000
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Local Google account picker without Cloud setup (default on in development):
# ALLOW_LOCAL_GOOGLE_AUTH=true

# Twilio SMS for phone OTP (required in production). Without these, local/dev
# mocks SMS and returns `devOtp` in the register/start response.
# Create at https://console.twilio.com — trial accounts can only SMS verified numbers.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+12025550123
# Or use a Messaging Service instead of FROM:
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Password-reset + signup verification emails (Resend).
# Local/dev without a key mocks email. Production requires RESEND_API_KEY.
# FRONTEND_URL=http://localhost:3000
# RESEND_API_KEY=re_xxxxxxxx
#
# For EVERY new user (not only your inbox):
# 1) Resend → Domains → add & verify your domain (DNS SPF/DKIM)
# 2) Set EMAIL_FROM to that domain, e.g.:
# EMAIL_FROM=PlayPK <noreply@yourdomain.com>
# beth.t@example.com only delivers to the Resend account owner.

# ── Dashboard (apps/dashboard/.env.local) ─────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
# Fallback for sports/venues when Express API is unreachable (e.g. on Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Supabase Auth sync (apps/api/.env) — optional; used by seed / db:sync-supabase-auth
# Project URL can reuse NEXT_PUBLIC_SUPABASE_URL. Service role is required to write Auth users.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Never expose the service role key to the browser or commit it.
# Note: PlayPK login still uses Prisma/JWT. This only mirrors demos into Authentication → Users.

# ── Vercel (dashboard project → Settings → Environment Variables) ─────────────
# Browser calls same-origin /api/*; signup email OTP runs on Vercel (Resend).
# Other /api/* paths rewrite to Railway.
# REQUIRED for Create account codes (Production + Preview):
#   RESEND_API_KEY=re_xxxxxxxx
#   EMAIL_FROM=PlayPK <beth.t@example.com>
# Prefer setting explicitly (Production + Preview). If unset on Vercel, the
# dashboard falls back to https://api-production-2057.up.railway.app
# API_URL=https://api-production-2057.up.railway.app
# Redeploy after changing API_URL. Supabase alone does not handle login.

# ── Vercel (walk-in POS — separate project, Root Directory = apps/walkin) ─────
# Create a second Vercel project from the same GitHub repo.
# Root Directory: apps/walkin
# Install / Build: use apps/walkin/vercel.json (auto-detected)
# Env (Production + Preview):
#   NEXT_PUBLIC_API_URL=https://api-production-2057.up.railway.app
#   API_URL=https://api-production-2057.up.railway.app
# Login: frontdesk@playpk.demo / PlayPK@desk1  (must exist in Railway DB — run seed)

# ── Mobile (apps/mobile/.env) ────────────────────────────────────────────────
# Use localhost for iOS Simulator / Expo web.
# On a physical device, set this to your machine LAN IP, e.g. http://192.168.1.10:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
