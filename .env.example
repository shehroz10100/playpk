# Copy to apps/api/.env for local development
# Or use: cp .env.example apps/api/.env

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://playpk:playpk@localhost:5432/playpk?schema=public

# Redis (matches docker-compose.yml)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Local file storage
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:4000/uploads

# Slot locking
SLOT_LOCK_TTL_SECONDS=30
