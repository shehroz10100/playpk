{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bash scripts/vercel-install.sh",
  "buildCommand": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:5432/postgres}\" npx prisma generate --schema=apps/api/prisma/schema.prisma && npm run build --workspace=@playpk/dashboard",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-2057.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api-production-2057.up.railway.app/health"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api-production-2057.up.railway.app/uploads/:path*"
    }
  ],
  "outputDirectory": "apps/dashboard/.next"
}
