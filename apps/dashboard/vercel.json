{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "NPM_CONFIG_PRODUCTION=false npm install --prefix=../.. --workspace=@playpk/dashboard --workspace=@playpk/shared-types --include-workspace-root --include=dev --no-audit --no-fund",
  "buildCommand": "npm run build --prefix=../.. --workspace=@playpk/dashboard",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api-production-2057.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api-production-2057.up.railway.app/health"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://api-production-2057.up.railway.app/uploads/:path*"
    }
  ]
}
