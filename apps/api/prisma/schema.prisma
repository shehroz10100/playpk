generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  PLAYER
  COMPANY_OWNER
  BRANCH_MANAGER
  ADMIN
  FRONT_DESK
  GUEST
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MembershipPlan {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TournamentFormat {
  LEAGUE
  KNOCKOUT
  GROUPS
}

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CompanyApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum BookingSource {
  ONLINE
  WALK_IN
  PHONE
}

enum PricingDayType {
  WEEKDAY
  WEEKEND
  HOLIDAY
}

enum PricingChannel {
  ONLINE
  WALK_IN
  BOTH
}

enum MatchVisibility {
  PUBLIC
  PRIVATE
}

enum CasualMatchType {
  COMPETITIVE
  FRIENDLY
}

enum MatchFormat {
  SINGLES
  DOUBLES
  EIGHT_A_SIDE
  TEN_A_SIDE
  FOURTEEN_A_SIDE
}

enum OpenMatchStatus {
  OPEN
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OpenMatchPlayerStatus {
  JOINED
  INVITED
  LEFT
  DECLINED
}

enum MatchGenderPreference {
  MEN
  WOMEN
  MIXED
  ANY
}

enum FollowStatus {
  PENDING
  ACCEPTED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  name          String
  email         String?     @unique
  phone         String?     @unique
  passwordHash  String?
  role          UserRole    @default(PLAYER)
  loyaltyPoints Int         @default(0)
  loyaltyTier   LoyaltyTier @default(BRONZE)
  walletBalance Decimal     @default(0) @db.Decimal(12, 2)
  suspendedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ownedCompanies      Company[]
  bookings            Booking[]            @relation("BookingCustomer")
  bookingsCreated     Booking[]            @relation("BookingStaff")
  reviews             Review[]
  waitlistEntries     Waitlist[]
  loyaltyTransactions LoyaltyTransaction[]
  walletTransactions  WalletTransaction[]
  notifications       Notification[]
  memberships         Membership[]
  managedBranches     Branch[]             @relation("BranchManager")
  refreshTokens       RefreshToken[]
  tournamentRegs      TournamentRegistration[]
  captainedTeams      Team[]               @relation("TeamCaptain")
  teamMemberships     TeamMember[]
  teamInvitesSent     TeamInvite[]         @relation("TeamInviteSender")
  teamInvitesReceived TeamInvite[]         @relation("TeamInviteRecipient")
  ticketsReported     SupportTicket[]      @relation("TicketReporter")
  ticketsAssigned     SupportTicket[]      @relation("TicketAssignee")
  companiesApproved   Company[]            @relation("CompanyApprover")
  playerProfile       PlayerProfile?
  openMatchesCreated  OpenMatch[]          @relation("OpenMatchHost")
  openMatchPlayers    OpenMatchPlayer[]
  follows             Follow[]             @relation("FollowFollower")
  followers           Follow[]             @relation("FollowFollowing")
  socialPosts         SocialPost[]
  socialStars         SocialStar[]
  socialComments      SocialComment[]
  contactHashes       ContactHash[]
  resultsReported     OpenMatchResult[]    @relation("ResultReporter")
  hostedTournaments   Tournament[]         @relation("TournamentHost")
  dmThreadsAsOne      DirectThread[]       @relation("ThreadUserOne")
  dmThreadsAsTwo      DirectThread[]       @relation("ThreadUserTwo")
  directMessages      DirectMessage[]

  @@index([role])
  @@index([loyaltyTier])
  @@index([suspendedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id                 String                 @id @default(cuid())
  ownerId            String
  name               String
  description        String?
  logoUrl            String?
  bankAccountName    String?
  bankAccountNumber  String?
  bankName           String?
  approvalStatus     CompanyApprovalStatus  @default(PENDING)
  approvedAt         DateTime?
  approvedById       String?
  rejectionReason    String?
  commissionPercent  Decimal                @default(10) @db.Decimal(5, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("CompanyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  branches   Branch[]
  coupons    Coupon[]
  tickets    SupportTicket[]
  pricingRules PricingRule[]
  branding   BrandingSettings?

  @@index([ownerId])
  @@index([approvalStatus])
}

model Branch {
  id               String                @id @default(cuid())
  companyId        String
  name             String
  city             String
  address          String
  latitude         Float?
  longitude        Float?
  managerId        String?
  operatingHoursStart String @default("06:00") // HH:mm local
  operatingHoursEnd   String @default("23:00")
  approvalStatus   CompanyApprovalStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager     User?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  courts      Court[]
  reviews     Review[]
  tournaments Tournament[]
  tickets     SupportTicket[]
  openMatches OpenMatch[]
  pricingRules PricingRule[]

  @@index([companyId])
  @@index([city])
  @@index([managerId])
  @@index([approvalStatus])
}

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique
  iconUrl   String?
  createdAt DateTime @default(now())

  courts         Court[]
  tournaments    Tournament[]
  teams          Team[]
  playerProfiles PlayerProfile[]
  openMatches    OpenMatch[]
  pricingRules   PricingRule[]
}

model Court {
  id                 String   @id @default(cuid())
  branchId           String
  sportId            String
  name               String
  capacity           Int      @default(4)
  pricePerHour       Decimal  @db.Decimal(12, 2)
  indoor             Boolean  @default(true)
  hasAC              Boolean  @default(false)
  equipmentAvailable String[] @default([])
  photos             String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport  @relation(fields: [sportId], references: [id], onDelete: Restrict)
  slots  Slot[]
  pricingRules PricingRule[]

  @@index([branchId])
  @@index([sportId])
  @@unique([branchId, name])
}

model Slot {
  id        String     @id @default(cuid())
  courtId   String
  date      DateTime   @db.Date
  startTime String // HH:mm
  endTime   String // HH:mm
  status    SlotStatus @default(AVAILABLE)
  price     Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  court           Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  waitlistEntries Waitlist[]

  @@unique([courtId, date, startTime])
  @@index([courtId, date, status])
  @@index([status])
}

model Booking {
  id                     String         @id @default(cuid())
  userId                 String
  slotId                 String
  status                 BookingStatus  @default(PENDING)
  totalAmount            Decimal        @db.Decimal(12, 2)
  paymentStatus          PaymentStatus  @default(PENDING)
  paymentIntentId        String?
  /// ONLINE values: mock|wallet|jazzcash|easypaisa|card|bank_transfer
  /// WALK_IN values: CASH|JAZZCASH|EASYPAISA|CARD|WALLET
  paymentMethod          String?
  paymentProofUrl        String?
  paymentProofUploadedAt DateTime?
  bookingSource          BookingSource  @default(ONLINE)
  createdByStaffId       String?
  guestName              String?
  guestPhone             String?
  qrCode                 String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  cancelledAt            DateTime?

  user           User  @relation("BookingCustomer", fields: [userId], references: [id], onDelete: Restrict)
  createdByStaff User? @relation("BookingStaff", fields: [createdByStaffId], references: [id], onDelete: SetNull)
  slot           Slot  @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([slotId])
  @@index([status])
  @@index([paymentStatus])
  @@index([bookingSource])
  @@index([createdByStaffId])
}

model PricingRule {
  id              String         @id @default(cuid())
  companyId       String
  branchId        String?
  courtId         String?
  sportId         String?
  dayType         PricingDayType
  timeRangeStart  String // HH:mm
  timeRangeEnd    String // HH:mm
  channel         PricingChannel @default(BOTH)
  priceOverride   Decimal?       @db.Decimal(12, 2)
  priceMultiplier Decimal?       @db.Decimal(8, 4)
  priority        Int            @default(0)
  validFrom       DateTime?
  validTo         DateTime?
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  court   Court?  @relation(fields: [courtId], references: [id], onDelete: Cascade)
  sport   Sport?  @relation(fields: [sportId], references: [id], onDelete: Cascade)

  @@index([companyId, active, priority])
  @@index([branchId])
  @@index([courtId])
  @@index([sportId])
  @@index([channel])
}

model BrandingSettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  logoUrl           String?
  primaryColor      String   @default("#00A651")
  secondaryColor    String   @default("#0B1F3A")
  businessName      String?
  receiptFooterText String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([rating])
}

model Waitlist {
  id        String   @id @default(cuid())
  userId    String
  slotId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([userId, slotId])
  @@index([slotId])
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  bookingId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
}

enum WalletTxnType {
  TOPUP
  DEBIT
  REFUND
}

model WalletTransaction {
  id        String        @id @default(cuid())
  userId    String
  amount    Decimal       @db.Decimal(12, 2)
  type      WalletTxnType
  reason    String
  bookingId String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  plan      MembershipPlan
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Coupon {
  id            String       @id @default(cuid())
  companyId     String
  code          String
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int?
  usageCount    Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([code])
}

model SupportTicket {
  id           String         @id @default(cuid())
  userId       String
  companyId    String?
  branchId     String?
  assignedToId String?
  subject      String
  body         String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User     @relation("TicketReporter", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([companyId])
}

model Tournament {
  id              String           @id @default(cuid())
  branchId        String
  hostUserId      String?
  name            String
  sportId         String
  format          TournamentFormat
  status          TournamentStatus @default(OPEN)
  entryFee        Decimal          @db.Decimal(12, 2)
  prizePool       Decimal          @db.Decimal(12, 2) @default(0)
  maxParticipants Int?
  description     String?
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  branch         Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  host           User?                    @relation("TournamentHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  sport          Sport                    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  registrations  TournamentRegistration[]
  matches        TournamentMatch[]

  @@index([branchId])
  @@index([hostUserId])
  @@index([sportId])
  @@index([status])
  @@index([startDate, endDate])
}

model TournamentRegistration {
  id              String        @id @default(cuid())
  tournamentId    String
  userId          String
  teamId          String?
  seed            Int?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  paidAmount      Decimal       @db.Decimal(12, 2) @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)

  homeMatches TournamentMatch[] @relation("MatchHome")
  awayMatches TournamentMatch[] @relation("MatchAway")
  wonMatches  TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([teamId])
}

model TournamentMatch {
  id                   String      @id @default(cuid())
  tournamentId         String
  round                Int
  matchIndex           Int
  homeRegistrationId   String?
  awayRegistrationId   String?
  homeScore            Int?
  awayScore            Int?
  winnerRegistrationId String?
  status               MatchStatus @default(SCHEDULED)
  scheduledAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tournament Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  home       TournamentRegistration? @relation("MatchHome", fields: [homeRegistrationId], references: [id], onDelete: SetNull)
  away       TournamentRegistration? @relation("MatchAway", fields: [awayRegistrationId], references: [id], onDelete: SetNull)
  winner     TournamentRegistration? @relation("MatchWinner", fields: [winnerRegistrationId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, matchIndex])
  @@index([tournamentId, round])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  sportId   String?
  captainId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport  Sport?  @relation(fields: [sportId], references: [id], onDelete: SetNull)
  captain User   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  members TeamMember[]
  invites TeamInvite[]
  tournamentRegistrations TournamentRegistration[]

  @@index([captainId])
  @@index([sportId])
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id             String           @id @default(cuid())
  teamId         String
  invitedById    String
  email          String?
  phone          String?
  invitedUserId String?
  status         TeamInviteStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("TeamInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User? @relation("TeamInviteRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([email])
  @@index([phone])
  @@index([invitedUserId])
}

// ─── Social / open matchmaking ───────────────────────────────────────────────

model PlayerProfile {
  id                 String     @id @default(cuid())
  userId             String     @unique
  skillLevel         SkillLevel @default(BEGINNER)
  primarySportId     String?
  bio                String?
  wins               Int        @default(0)
  losses             Int        @default(0)
  points             Int        @default(0)
  matchesPlayed      Int        @default(0)
  onboardingComplete Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user         User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  primarySport Sport? @relation(fields: [primarySportId], references: [id], onDelete: SetNull)

  @@index([skillLevel])
  @@index([points])
}

model OpenMatch {
  id          String            @id @default(cuid())
  hostId      String
  sportId     String
  branchId    String?
  title       String
  notes       String?
  visibility  MatchVisibility   @default(PUBLIC)
  matchType   CasualMatchType   @default(FRIENDLY)
  format      MatchFormat       @default(DOUBLES)
  skillMin    SkillLevel        @default(BEGINNER)
  skillMax    SkillLevel        @default(PRO)
  genderPreference MatchGenderPreference @default(ANY)
  pricePerPlayer   Decimal?     @db.Decimal(10, 2)
  status      OpenMatchStatus   @default(OPEN)
  maxPlayers  Int
  scheduledAt DateTime?
  city        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  host    User             @relation("OpenMatchHost", fields: [hostId], references: [id], onDelete: Cascade)
  sport   Sport            @relation(fields: [sportId], references: [id], onDelete: Restrict)
  branch  Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  players OpenMatchPlayer[]
  result  OpenMatchResult?

  @@index([status, visibility, scheduledAt])
  @@index([sportId, city])
  @@index([hostId])
}

model OpenMatchPlayer {
  id        String                @id @default(cuid())
  matchId   String
  userId    String
  status    OpenMatchPlayerStatus @default(JOINED)
  side      String?
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  match OpenMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId, status])
}

model OpenMatchResult {
  id           String   @id @default(cuid())
  matchId      String   @unique
  reportedById String
  homeScore    Int
  awayScore    Int
  winnerSide   String?
  notes        String?
  createdAt    DateTime @default(now())

  match      OpenMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  reportedBy User      @relation("ResultReporter", fields: [reportedById], references: [id], onDelete: Cascade)
}

model Follow {
  id          String       @id @default(cuid())
  followerId  String
  followingId String
  status      FollowStatus @default(ACCEPTED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  follower  User @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("FollowFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId, status])
  @@index([followerId, status])
}

/** Sorted pair of users (userOneId < userTwoId) for 1:1 DMs between connected players. */
model DirectThread {
  id        String   @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOne  User            @relation("ThreadUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User            @relation("ThreadUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages DirectMessage[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, updatedAt])
  @@index([userTwoId, updatedAt])
}

model DirectMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread DirectThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([senderId])
}

model SocialPost {
  id        String   @id @default(cuid())
  authorId  String
  body      String
  matchId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  stars    SocialStar[]
  comments SocialComment[]

  @@index([createdAt])
  @@index([authorId])
}

model SocialStar {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
}

model SocialComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([userId])
}

model ContactHash {
  id        String   @id @default(cuid())
  userId    String
  phoneHash String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phoneHash])
  @@index([phoneHash])
}
