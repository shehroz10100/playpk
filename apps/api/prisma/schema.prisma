generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  PLAYER
  COMPANY_OWNER
  BRANCH_MANAGER
  ADMIN
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum MembershipPlan {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum TournamentFormat {
  LEAGUE
  KNOCKOUT
  GROUPS
}

enum TournamentStatus {
  DRAFT
  OPEN
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MatchStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TeamMemberRole {
  CAPTAIN
  MEMBER
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CompanyApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String      @id @default(cuid())
  name          String
  email         String?     @unique
  phone         String?     @unique
  passwordHash  String?
  role          UserRole    @default(PLAYER)
  loyaltyPoints Int         @default(0)
  loyaltyTier   LoyaltyTier @default(BRONZE)
  walletBalance Decimal     @default(0) @db.Decimal(12, 2)
  suspendedAt   DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  ownedCompanies      Company[]
  bookings            Booking[]
  reviews             Review[]
  waitlistEntries     Waitlist[]
  loyaltyTransactions LoyaltyTransaction[]
  walletTransactions  WalletTransaction[]
  notifications       Notification[]
  memberships         Membership[]
  managedBranches     Branch[]             @relation("BranchManager")
  refreshTokens       RefreshToken[]
  tournamentRegs      TournamentRegistration[]
  captainedTeams      Team[]               @relation("TeamCaptain")
  teamMemberships     TeamMember[]
  teamInvitesSent     TeamInvite[]         @relation("TeamInviteSender")
  teamInvitesReceived TeamInvite[]         @relation("TeamInviteRecipient")
  ticketsReported     SupportTicket[]      @relation("TicketReporter")
  ticketsAssigned     SupportTicket[]      @relation("TicketAssignee")
  companiesApproved   Company[]            @relation("CompanyApprover")

  @@index([role])
  @@index([loyaltyTier])
  @@index([suspendedAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Company {
  id                 String                 @id @default(cuid())
  ownerId            String
  name               String
  description        String?
  logoUrl            String?
  approvalStatus     CompanyApprovalStatus  @default(PENDING)
  approvedAt         DateTime?
  approvedById       String?
  rejectionReason    String?
  commissionPercent  Decimal                @default(10) @db.Decimal(5, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  approvedBy User?           @relation("CompanyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  branches   Branch[]
  coupons    Coupon[]
  tickets    SupportTicket[]

  @@index([ownerId])
  @@index([approvalStatus])
}

model Branch {
  id               String                @id @default(cuid())
  companyId        String
  name             String
  city             String
  address          String
  latitude         Float?
  longitude        Float?
  managerId        String?
  operatingHoursStart String @default("06:00") // HH:mm local
  operatingHoursEnd   String @default("23:00")
  approvalStatus   CompanyApprovalStatus @default(PENDING)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager     User?        @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  courts      Court[]
  reviews     Review[]
  tournaments Tournament[]
  tickets     SupportTicket[]

  @@index([companyId])
  @@index([city])
  @@index([managerId])
  @@index([approvalStatus])
}

model Sport {
  id        String   @id @default(cuid())
  name      String   @unique
  iconUrl   String?
  createdAt DateTime @default(now())

  courts      Court[]
  tournaments Tournament[]
  teams       Team[]
}

model Court {
  id                 String   @id @default(cuid())
  branchId           String
  sportId            String
  name               String
  capacity           Int      @default(4)
  pricePerHour       Decimal  @db.Decimal(12, 2)
  indoor             Boolean  @default(true)
  hasAC              Boolean  @default(false)
  equipmentAvailable String[] @default([])
  photos             String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport  Sport  @relation(fields: [sportId], references: [id], onDelete: Restrict)
  slots  Slot[]

  @@index([branchId])
  @@index([sportId])
  @@unique([branchId, name])
}

model Slot {
  id        String     @id @default(cuid())
  courtId   String
  date      DateTime   @db.Date
  startTime String // HH:mm
  endTime   String // HH:mm
  status    SlotStatus @default(AVAILABLE)
  price     Decimal    @db.Decimal(12, 2)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  court           Court      @relation(fields: [courtId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  waitlistEntries Waitlist[]

  @@unique([courtId, date, startTime])
  @@index([courtId, date, status])
  @@index([status])
}

model Booking {
  id              String        @id @default(cuid())
  userId          String
  slotId          String
  status          BookingStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(12, 2)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  qrCode          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  cancelledAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  slot Slot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([slotId])
  @@index([status])
  @@index([paymentStatus])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  branchId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([rating])
}

model Waitlist {
  id        String   @id @default(cuid())
  userId    String
  slotId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot Slot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([userId, slotId])
  @@index([slotId])
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  reason    String
  bookingId String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
}

enum WalletTxnType {
  TOPUP
  DEBIT
  REFUND
}

model WalletTransaction {
  id        String        @id @default(cuid())
  userId    String
  amount    Decimal       @db.Decimal(12, 2)
  type      WalletTxnType
  reason    String
  bookingId String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Membership {
  id        String           @id @default(cuid())
  userId    String
  plan      MembershipPlan
  startDate DateTime         @db.Date
  endDate   DateTime         @db.Date
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Coupon {
  id            String       @id @default(cuid())
  companyId     String
  code          String
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  validFrom     DateTime
  validTo       DateTime
  usageLimit    Int?
  usageCount    Int          @default(0)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([code])
}

model SupportTicket {
  id           String         @id @default(cuid())
  userId       String
  companyId    String?
  branchId     String?
  assignedToId String?
  subject      String
  body         String
  status       TicketStatus   @default(OPEN)
  priority     TicketPriority @default(MEDIUM)
  adminNotes   String?
  resolvedAt   DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User     @relation("TicketReporter", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?    @relation("TicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch     Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId])
  @@index([companyId])
}

model Tournament {
  id              String           @id @default(cuid())
  branchId        String
  name            String
  sportId         String
  format          TournamentFormat
  status          TournamentStatus @default(OPEN)
  entryFee        Decimal          @db.Decimal(12, 2)
  prizePool       Decimal          @db.Decimal(12, 2) @default(0)
  maxParticipants Int?
  description     String?
  startDate       DateTime         @db.Date
  endDate         DateTime         @db.Date
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  branch         Branch                   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sport          Sport                    @relation(fields: [sportId], references: [id], onDelete: Restrict)
  registrations  TournamentRegistration[]
  matches        TournamentMatch[]

  @@index([branchId])
  @@index([sportId])
  @@index([status])
  @@index([startDate, endDate])
}

model TournamentRegistration {
  id              String        @id @default(cuid())
  tournamentId    String
  userId          String
  teamId          String?
  seed            Int?
  paymentStatus   PaymentStatus @default(PENDING)
  paymentIntentId String?
  paidAmount      Decimal       @db.Decimal(12, 2) @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)

  homeMatches TournamentMatch[] @relation("MatchHome")
  awayMatches TournamentMatch[] @relation("MatchAway")
  wonMatches  TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
  @@index([teamId])
}

model TournamentMatch {
  id                   String      @id @default(cuid())
  tournamentId         String
  round                Int
  matchIndex           Int
  homeRegistrationId   String?
  awayRegistrationId   String?
  homeScore            Int?
  awayScore            Int?
  winnerRegistrationId String?
  status               MatchStatus @default(SCHEDULED)
  scheduledAt          DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tournament Tournament             @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  home       TournamentRegistration? @relation("MatchHome", fields: [homeRegistrationId], references: [id], onDelete: SetNull)
  away       TournamentRegistration? @relation("MatchAway", fields: [awayRegistrationId], references: [id], onDelete: SetNull)
  winner     TournamentRegistration? @relation("MatchWinner", fields: [winnerRegistrationId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, matchIndex])
  @@index([tournamentId, round])
}

model Team {
  id        String   @id @default(cuid())
  name      String
  sportId   String?
  captainId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sport  Sport?  @relation(fields: [sportId], references: [id], onDelete: SetNull)
  captain User   @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: Restrict)
  members TeamMember[]
  invites TeamInvite[]
  tournamentRegistrations TournamentRegistration[]

  @@index([captainId])
  @@index([sportId])
}

model TeamMember {
  id        String         @id @default(cuid())
  teamId    String
  userId    String
  role      TeamMemberRole @default(MEMBER)
  joinedAt  DateTime       @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model TeamInvite {
  id             String           @id @default(cuid())
  teamId         String
  invitedById    String
  email          String?
  phone          String?
  invitedUserId String?
  status         TeamInviteStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("TeamInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedUser User? @relation("TeamInviteRecipient", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([teamId, status])
  @@index([email])
  @@index([phone])
  @@index([invitedUserId])
}
